<Window x:Class="tagmane.CaptionGenerationSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="キャプション生成設定" Height="1100" Width="700" MinHeight="750" MinWidth="600"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize"
        Background="#1E1E1E" Foreground="White">
    
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <TextBlock Grid.Row="0" Text="GLM-4.1V キャプション生成設定" 
                   FontSize="16" FontWeight="Bold" Margin="0,0,0,20"
                   Foreground="White"/>
        
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" 
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <!-- システムプロンプト設定 -->
                <GroupBox Header="システムプロンプト" Margin="0,0,0,15" Foreground="White"
                          Background="#1E1E1E" BorderBrush="#555">
                    <Grid Margin="10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="GLM-4.1Vに送信するシステムプロンプトを設定できます" 
                                   FontSize="11" Foreground="LightGray" Margin="0,0,0,8"/>
                        <TextBox Grid.Row="1" x:Name="SystemPromptTextBox" 
                                 Text="You are a helpful assistant that describes images accurately and concisely."
                                 TextWrapping="Wrap" AcceptsReturn="True" MinHeight="80"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                 Background="#2D2D2D" Foreground="White" BorderBrush="#666"
                                 FontFamily="Consolas" FontSize="11" Padding="8"/>
                    </Grid>
                </GroupBox>
                
                <!-- ユーザープロンプト設定 -->
                <GroupBox Header="ユーザープロンプト" Margin="0,0,0,15" Foreground="White"
                          Background="#1E1E1E" BorderBrush="#555">
                    <Grid Margin="10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="画像に対して送信するメインプロンプトを設定できます" 
                                   FontSize="11" Foreground="LightGray" Margin="0,0,0,8"/>
                        <TextBox Grid.Row="1" x:Name="UserPromptTextBox" 
                                 Text="Please describe this image in detail, focusing on the main subjects, their actions, the setting, and any notable details."
                                 TextWrapping="Wrap" AcceptsReturn="True" MinHeight="80"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                 Background="#2D2D2D" Foreground="White" BorderBrush="#666"
                                 FontFamily="Consolas" FontSize="11" Padding="8"/>
                    </Grid>
                </GroupBox>
                
                <!-- 最大トークン数設定 -->
                <GroupBox Header="最大トークン数" Margin="0,0,0,15" Foreground="White"
                          Background="#1E1E1E" BorderBrush="#555">
                    <StackPanel Margin="10">
                        <TextBlock Text="生成するキャプションの最大トークン数を設定" 
                                   FontSize="11" Foreground="LightGray" Margin="0,0,0,8"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Slider x:Name="MaxTokensSlider" Grid.Column="0" 
                                    Minimum="50" Maximum="4096" Value="2048" 
                                    VerticalAlignment="Center" Margin="0,0,15,0"
                                    ValueChanged="MaxTokensSlider_ValueChanged"/>
                            <TextBlock x:Name="MaxTokensValueText" Grid.Column="1"
                                       Text="2048" VerticalAlignment="Center" 
                                       MinWidth="60" TextAlignment="Center"
                                       Background="#2D2D2D" Padding="5" Foreground="White"/>
                        </Grid>
                    </StackPanel>
                </GroupBox>
                
                <!-- Temperature設定 -->
                <GroupBox Header="Temperature" Margin="0,0,0,15" Foreground="White"
                          Background="#1E1E1E" BorderBrush="#555">
                    <StackPanel Margin="10">
                        <TextBlock Text="生成の創造性を制御 (0.0: 確定的, 1.0: 創造的)" 
                                   FontSize="11" Foreground="LightGray" Margin="0,0,0,8"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Slider x:Name="TemperatureSlider" Grid.Column="0" 
                                    Minimum="0.0" Maximum="1.0" Value="0.7" 
                                    VerticalAlignment="Center" Margin="0,0,15,0"
                                    ValueChanged="TemperatureSlider_ValueChanged"/>
                            <TextBlock x:Name="TemperatureValueText" Grid.Column="1"
                                       Text="0.7" VerticalAlignment="Center" 
                                       MinWidth="60" TextAlignment="Center"
                                       Background="#2D2D2D" Padding="5" Foreground="White"/>
                        </Grid>
                    </StackPanel>
                </GroupBox>
                
                <!-- Top-p設定 -->
                <GroupBox Header="Top-p" Margin="0,0,0,15" Foreground="White"
                          Background="#1E1E1E" BorderBrush="#555">
                    <StackPanel Margin="10">
                        <TextBlock Text="核サンプリングのしきい値 (0.0-1.0)" 
                                   FontSize="11" Foreground="LightGray" Margin="0,0,0,8"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Slider x:Name="TopPSlider" Grid.Column="0" 
                                    Minimum="0.0" Maximum="1.0" Value="0.9" 
                                    VerticalAlignment="Center" Margin="0,0,15,0"
                                    ValueChanged="TopPSlider_ValueChanged"/>
                            <TextBlock x:Name="TopPValueText" Grid.Column="1"
                                       Text="0.9" VerticalAlignment="Center" 
                                       MinWidth="60" TextAlignment="Center"
                                       Background="#2D2D2D" Padding="5" Foreground="White"/>
                        </Grid>
                    </StackPanel>
                </GroupBox>
                
                <!-- GPU設定 -->
                <GroupBox Header="GPU設定" Margin="0,0,0,15" Foreground="White"
                          Background="#1E1E1E" BorderBrush="#555">
                    <StackPanel Margin="10">
                        <TextBlock Text="使用するGPUを選択" 
                                   FontSize="11" Foreground="LightGray" Margin="0,0,0,8"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ComboBox x:Name="GpuSelectionComboBox" Grid.Column="0" 
                                      VerticalAlignment="Center" Margin="0,0,10,0"
                                      Background="#2D2D2D" Foreground="White" BorderBrush="#666"
                                      FontSize="11" Padding="5">
                                <ComboBox.Resources>
                                    <!-- ドロップダウン項目のスタイル -->
                                    <Style TargetType="ComboBoxItem">
                                        <Setter Property="Background" Value="#2D2D2D"/>
                                        <Setter Property="Foreground" Value="White"/>
                                        <Setter Property="BorderBrush" Value="#666"/>
                                        <Setter Property="Padding" Value="5"/>
                                        <Style.Triggers>
                                            <Trigger Property="IsHighlighted" Value="True">
                                                <Setter Property="Background" Value="#404040"/>
                                                <Setter Property="Foreground" Value="White"/>
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter Property="Background" Value="#555"/>
                                                <Setter Property="Foreground" Value="White"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                    <!-- ドロップダウンポップアップのスタイル -->
                                    <Style TargetType="Border" x:Key="DropDownBorder">
                                        <Setter Property="Background" Value="#2D2D2D"/>
                                        <Setter Property="BorderBrush" Value="#666"/>
                                        <Setter Property="BorderThickness" Value="1"/>
                                    </Style>
                                </ComboBox.Resources>
                                <ComboBox.Template>
                                    <ControlTemplate TargetType="ComboBox">
                                        <Grid>
                                            <ToggleButton x:Name="ToggleButton" 
                                                         Background="#2D2D2D" 
                                                         BorderBrush="#666" 
                                                         BorderThickness="1"
                                                         Focusable="False" 
                                                         IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                                         ClickMode="Press">
                                                <ToggleButton.Template>
                                                    <ControlTemplate TargetType="ToggleButton">
                                                        <Border Background="{TemplateBinding Background}" 
                                                               BorderBrush="{TemplateBinding BorderBrush}" 
                                                               BorderThickness="{TemplateBinding BorderThickness}">
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*"/>
                                                                    <ColumnDefinition Width="20"/>
                                                                </Grid.ColumnDefinitions>
                                                                <Path x:Name="Arrow" Grid.Column="1" 
                                                                     Fill="White" HorizontalAlignment="Center" 
                                                                     VerticalAlignment="Center" 
                                                                     Data="M 0 0 L 4 4 L 8 0 Z"/>
                                                            </Grid>
                                                        </Border>
                                                    </ControlTemplate>
                                                </ToggleButton.Template>
                                            </ToggleButton>
                                            <ContentPresenter x:Name="ContentSite" 
                                                            IsHitTestVisible="False" 
                                                            Content="{TemplateBinding SelectionBoxItem}" 
                                                            ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" 
                                                            ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}" 
                                                            Margin="5,3,23,3" 
                                                            VerticalAlignment="Center" 
                                                            HorizontalAlignment="Left" 
                                                            TextBlock.Foreground="White"/>
                                            <TextBox x:Name="PART_EditableTextBox" 
                                                    Style="{x:Null}" 
                                                    Template="{DynamicResource ComboBoxTextBox}" 
                                                    HorizontalAlignment="Left" 
                                                    VerticalAlignment="Center" 
                                                    Margin="3,3,23,3" 
                                                    Focusable="True" 
                                                    Background="Transparent" 
                                                    Foreground="White" 
                                                    Visibility="Hidden" 
                                                    IsReadOnly="{TemplateBinding IsReadOnly}"/>
                                            <Popup x:Name="Popup" 
                                                  Placement="Bottom" 
                                                  IsOpen="{TemplateBinding IsDropDownOpen}" 
                                                  AllowsTransparency="True" 
                                                  Focusable="False" 
                                                  PopupAnimation="Slide">
                                                <Grid x:Name="DropDown" 
                                                     SnapsToDevicePixels="True" 
                                                     MinWidth="{TemplateBinding ActualWidth}" 
                                                     MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                                    <Border x:Name="DropDownBorder" 
                                                           Background="#2D2D2D" 
                                                           BorderBrush="#666" 
                                                           BorderThickness="1"/>
                                                    <ScrollViewer Margin="4,6,4,6" SnapsToDevicePixels="True">
                                                        <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained"/>
                                                    </ScrollViewer>
                                                </Grid>
                                            </Popup>
                                        </Grid>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="HasItems" Value="False">
                                                <Setter TargetName="DropDownBorder" Property="MinHeight" Value="95"/>
                                            </Trigger>
                                            <Trigger Property="IsGrouping" Value="True">
                                                <Setter Property="ScrollViewer.CanContentScroll" Value="False"/>
                                            </Trigger>
                                            <Trigger SourceName="Popup" Property="AllowsTransparency" Value="True">
                                                <Setter TargetName="DropDownBorder" Property="CornerRadius" Value="0"/>
                                                <Setter TargetName="DropDownBorder" Property="Margin" Value="0,2,0,0"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ComboBox.Template>
                            </ComboBox>
                            <Button x:Name="RefreshGpuListButton" Grid.Column="1"
                                    Content="更新" Width="50" Height="25" 
                                    Click="RefreshGpuListButton_Click"
                                    Background="#444" Foreground="White" BorderBrush="#666"
                                    FontSize="10"/>
                        </Grid>
                        <TextBlock Text="複数GPUがある場合に使用するGPUを選択できます" 
                                   FontSize="10" Foreground="LightGray" Margin="0,8,0,0"/>
                    </StackPanel>
                </GroupBox>
                
                <!-- 追加オプション -->
                <GroupBox Header="追加オプション" Margin="0,0,0,15" Foreground="White"
                          Background="#1E1E1E" BorderBrush="#555">
                    <StackPanel Margin="10">
                        <!-- 既存タグ参考オプション -->
                        <CheckBox x:Name="UseExistingTagsCheckBox" Content="既存タグを参考にする" 
                                  IsChecked="True" Foreground="White" Margin="0,0,0,8"
                                  FontSize="12" Checked="UseExistingTagsCheckBox_CheckedChanged" 
                                  Unchecked="UseExistingTagsCheckBox_CheckedChanged"/>
                        <StackPanel Margin="25,0,0,8" x:Name="TagOptionsPanel">
                            <CheckBox x:Name="UseCharacterTagsCheckBox" Content="characterタグを与える" 
                                      IsChecked="True" Foreground="LightGray" Margin="0,0,0,4"
                                      FontSize="11"/>
                            <CheckBox x:Name="UseCopyrightTagsCheckBox" Content="copyrightタグを与える" 
                                      IsChecked="True" Foreground="LightGray" Margin="0,0,0,4"
                                      FontSize="11"/>
                            <CheckBox x:Name="UseGeneralTagsCheckBox" Content="generalタグを与える" 
                                      IsChecked="True" Foreground="LightGray" Margin="0,0,0,4"
                                      FontSize="11"/>
                            <CheckBox x:Name="UseArtistTagsCheckBox" Content="artistタグを与える" 
                                      IsChecked="False" Foreground="LightGray" Margin="0,0,0,4"
                                      FontSize="11"/>
                            <CheckBox x:Name="UseRatingTagsCheckBox" Content="ratingタグを与える" 
                                      IsChecked="False" Foreground="LightGray" Margin="0,0,0,4"
                                      FontSize="11"/>
                            <CheckBox x:Name="UseQualityTagsCheckBox" Content="qualityタグを与える" 
                                      IsChecked="False" Foreground="LightGray" Margin="0,0,0,4"
                                      FontSize="11"/>
                            <CheckBox x:Name="UseMetaTagsCheckBox" Content="metaタグを与える" 
                                      IsChecked="True" Foreground="LightGray" Margin="0,0,0,4"
                                      FontSize="11"/>
                            <CheckBox x:Name="UseModelTagsCheckBox" Content="modelタグを与える" 
                                      IsChecked="False" Foreground="LightGray" Margin="0,0,0,4"
                                      FontSize="11"/>
                        </StackPanel>
                        <TextBlock Text="画像に既に付けられているタグ情報を生成時に参考にします" 
                                   FontSize="10" Foreground="LightGray" Margin="25,0,0,15"/>
                        
                        <CheckBox x:Name="DetailedDescriptionCheckBox" Content="詳細な描写を生成" 
                                  IsChecked="False" Foreground="White" Margin="0,0,0,8"
                                  FontSize="12"/>
                        <TextBlock Text="より詳しく具体的なキャプションを生成します" 
                                   FontSize="10" Foreground="LightGray" Margin="25,0,0,0"/>
                    </StackPanel>
                </GroupBox>
            </StackPanel>
        </ScrollViewer>
        
        <!-- ボタン -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button x:Name="ResetButton" Content="デフォルトに戻す" 
                    Width="130" Height="35" Margin="0,0,10,0"
                    Click="ResetButton_Click" Background="#444" Foreground="White" BorderBrush="#666"
                    FontSize="11"/>
            <Button x:Name="OkButton" Content="OK" 
                    Width="80" Height="35" Margin="0,0,10,0" IsDefault="True"
                    Click="OkButton_Click" Background="#007ACC" Foreground="White" BorderBrush="#007ACC"
                    FontSize="11" FontWeight="Bold"/>
            <Button x:Name="CancelButton" Content="キャンセル" 
                    Width="80" Height="35" IsCancel="True"
                    Click="CancelButton_Click" Background="#555" Foreground="White" BorderBrush="#777"
                    FontSize="11"/>
        </StackPanel>
    </Grid>
</Window>