<Window x:Class="tagmane.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:tagmane"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        mc:Ignorable="d"
        Title="MainWindow" Height="900" Width="1600">
    <Window.Resources>
        <SolidColorBrush x:Key="SelectedTagBrush" Color="#E0FFE0"/>
    </Window.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1*"/>
            <ColumnDefinition Width="2*"/>
            <ColumnDefinition Width="1*"/>
            <ColumnDefinition Width="1*"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="1*"/>
            <ColumnDefinition Width="1*"/>  <!-- フィルタ条件パネル -->
        </Grid.ColumnDefinitions>

        <!-- 左ペイン -->
        <DockPanel Grid.Column="0">
            <StackPanel DockPanel.Dock="Top" Orientation="Vertical">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                        <Button Click="SelectFolder_Click">
                            <Button.Content>
                                <Image Source="/icon/open.png" Width="32" Height="32"/>
                            </Button.Content>
                            <Button.ToolTip>
                                <TextBlock Text="フォルダを選択(Ctrl+O)"/>
                            </Button.ToolTip>
                        </Button>
                        <Button Click="SaveTagsButton_Click">
                            <Button.Content>
                                <Image Source="/icon/save.png" Width="32" Height="32"/>
                            </Button.Content>
                            <Button.ToolTip>
                                <TextBlock Text="現在のタグ状態を保存(Ctrl+S)"/>
                            </Button.ToolTip>
                        </Button>
                        <Button Click="MoveDirectoryButton_Click">
                            <Button.Content>
                                <Image Source="/icon/move.png" Width="32" Height="32"/>
                            </Button.Content>
                            <Button.ToolTip>
                                <TextBlock Text="フィルタ中の画像のフォルダを移動(Ctrl+M)"/>
                            </Button.ToolTip>
                        </Button>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                        <Button Click="DeleteSelectedImageAndTags_Click">
                            <Button.Content>
                                <Image Source="/icon/trash.png" Width="32" Height="32"/>
                            </Button.Content>
                            <Button.ToolTip>
                                <TextBlock Text="選択中の画像とタグを削除(Del)"/>
                            </Button.ToolTip>
                        </Button>
                        <Button Click="DeleteFilteredImageAndTags_Click">
                            <Button.Content>
                                <Image Source="/icon/deldir.png" Width="32" Height="32"/>
                            </Button.Content>
                            <Button.ToolTip>
                                <TextBlock Text="フィルタ中の画像とタグを削除(Ctrl+Shift+Del)"/>
                            </Button.ToolTip>
                        </Button>
                    </StackPanel>
                </Grid>
                <CheckBox x:Name="ConfirmCheckBox" Content="操作時に確認する？" IsChecked="True" Margin="0,5,0,0"/>
                <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                    <TextBlock Text="webp DLL:" VerticalAlignment="Center" Margin="0,0,5,0"/>
                    <TextBox x:Name="WebPDllPathTextBox" IsReadOnly="True" VerticalAlignment="Center" HorizontalAlignment="Stretch"/>
                    <Button x:Name="SelectWebPDllButton" Content="開く" Margin="5,0,0,0" Click="SelectWebPDllButton_Click" HorizontalAlignment="Right"/>
                </StackPanel>
                <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="0,5,0,0">
                    <TextBlock Text="タグ保存形式:" VerticalAlignment="Center" Margin="0,0,5,0"/>
                    <ComboBox x:Name="TagFormatComboBox" Width="150" SelectedIndex="0">
                        <ComboBoxItem Content="aaaa (bbbb)"/>
                        <ComboBoxItem Content="aaaa \(bbbb\)"/>
                        <ComboBoxItem Content="aaaa_(bbbb)"/>
                    </ComboBox>
                </StackPanel>
                <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="0,5,0,0">
                    <TextBlock Text="ファイル形式:" VerticalAlignment="Center" Margin="0,0,5,0"/>
                    <CheckBox x:Name="SaveTxtFormatCheckBox" Content="TXT" IsChecked="True" Margin="0,0,10,0"/>
                    <CheckBox x:Name="SaveJsonFormatCheckBox" Content="JSON" IsChecked="False"/>
                </StackPanel>
                <TextBlock x:Name="ImageCountDisplay" DockPanel.Dock="Bottom" Text="画像数: 0/0" Margin="5"/>
            </StackPanel>
            <ListBox x:Name="ImageListBox" SelectionChanged="ImageListBox_SelectionChanged"/>
        </DockPanel>

        <!-- 中央ペイン -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="2*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/> <!-- オプション欄用 -->
                <RowDefinition Height="Auto"/> <!-- 高度な削除用 -->
                <RowDefinition Height="Auto"/> <!-- 画像編集用 -->
            </Grid.RowDefinitions>
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center">
                    <Button x:Name="UndoButton" Click="UndoButton_Click">
                        <Button.Content>
                            <Image Source="/icon/undo.png" Width="32" Height="32"/>
                        </Button.Content>
                        <Button.ToolTip>
                            <TextBlock Text="元に戻す(Ctrl+Z)"/>
                        </Button.ToolTip>
                    </Button>
                    <Button x:Name="RedoButton" Click="RedoButton_Click">
                        <Button.Content>
                            <Image Source="/icon/redo.png" Width="32" Height="32"/>
                        </Button.Content>
                        <Button.ToolTip>
                            <TextBlock Text="やり直し(Ctrl+Y)"/>
                        </Button.ToolTip>
                    </Button>
                </StackPanel>
                <Button Grid.Column="2" Click="CancelButton_Click" HorizontalAlignment="Right" Margin="0,0,5,0">
                    <Button.Content>
                        <Image Source="/icon/cancel.png" Width="32" Height="32"/>
                    </Button.Content>
                    <Button.ToolTip>
                        <TextBlock Text="キャンセル(Esc)"/>
                    </Button.ToolTip>
                </Button>
            </Grid>
            <Grid Grid.Row="1">
                <!-- チェッカーボードパターンの背景 -->
                <Rectangle>
                    <Rectangle.Fill>
                        <DrawingBrush TileMode="Tile" Viewport="0,0,16,16" ViewportUnits="Absolute">
                            <DrawingBrush.Drawing>
                                <DrawingGroup>
                                    <GeometryDrawing Brush="#FFF5F5F5">
                                        <GeometryDrawing.Geometry>
                                            <RectangleGeometry Rect="0,0,16,16"/>
                                        </GeometryDrawing.Geometry>
                                    </GeometryDrawing>
                                    <GeometryDrawing Brush="#FFE5E5E5">
                                        <GeometryDrawing.Geometry>
                                            <GeometryGroup>
                                                <RectangleGeometry Rect="0,0,8,8"/>
                                                <RectangleGeometry Rect="8,8,8,8"/>
                                            </GeometryGroup>
                                        </GeometryDrawing.Geometry>
                                    </GeometryDrawing>
                                </DrawingGroup>
                            </DrawingBrush.Drawing>
                        </DrawingBrush>
                    </Rectangle.Fill>
                </Rectangle>
                
                <!-- 既存のImage要素 -->
                <Image x:Name="SelectedImage" 
                       Stretch="Uniform"
                       MouseMove="SelectedImage_MouseMove"
                       MouseDown="SelectedImage_MouseDown"
                       PreviewMouseMove="SelectedImage_PreviewMouseMove"
                       RenderOptions.BitmapScalingMode="HighQuality">
                    <Image.Style>
                        <Style TargetType="Image">
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Cursor" Value="Hand"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Image.Style>
                </Image>
                <Canvas x:Name="SelectionCanvas" 
                        Background="#01FFFFFF"
                        IsHitTestVisible="True"
                        MouseLeftButtonDown="SelectionCanvas_MouseLeftButtonDown"
                        MouseMove="SelectionCanvas_MouseMove"
                        MouseLeftButtonUp="SelectionCanvas_MouseLeftButtonUp">
                    <Rectangle x:Name="SelectionRectangle"
                              Stroke="Red"
                              StrokeThickness="2"
                              Fill="#3FFF0000"
                              Visibility="Collapsed"/>
                </Canvas>
                <TextBlock x:Name="SelectionHint"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Top"
                           Margin="0,10,0,0"
                           Foreground="Gray"
                           Text="Ctrl+ドラッグで範囲選択"
                           Visibility="Collapsed"
                           Panel.ZIndex="1"
                           Opacity="0.7"/>
            </Grid>
            <Grid Grid.Row="2">
                <!-- 画像情報とテキストファイル内容のセクション全体を Expander で囲む -->
                <Expander Grid.Row="2" Header="画像情報とテキストファイル内容" IsExpanded="False"> 
                    <Grid Margin="5"> <!-- Expanderのコンテンツとして元のGridを入れる -->
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- 左側：画像情報 (変更なし) -->
                        <Grid Grid.Column="0" Margin="5,0,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/> <!-- TextBlock "画像情報" 用 -->
                                <RowDefinition Height="*"/>   <!-- 実際の情報Grid用 -->
                            </Grid.RowDefinitions>
                            
                            <!-- "画像情報" テキストブロックは Expander ヘッダーがあるので不要なら削除してもOK -->
                            <!-- <TextBlock Text="画像情報" 
                                       FontWeight="Bold" 
                                       Margin="0,5,0,5"
                                       Grid.Row="0"/> -->
                                       
                            <Grid Grid.Row="1" Margin="0,5,0,0"> <!-- インデックスを0から開始に変更 -->
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- フルパス -->
                                <TextBlock Text="フルパス:" 
                                           Grid.Row="0" Grid.Column="0" 
                                           Margin="0,2,5,2"
                                           VerticalAlignment="Center"/>
                                <TextBox x:Name="ImagePathTextBox"
                                         Grid.Row="0" Grid.Column="1"
                                         IsReadOnly="True"
                                         TextWrapping="Wrap"
                                         Margin="0,2"/>

                                <!-- 拡張子 -->
                                <TextBlock Text="拡張子:" 
                                           Grid.Row="1" Grid.Column="0"
                                           Margin="0,2,5,2"
                                           VerticalAlignment="Center"/>
                                <TextBox x:Name="ImageExtensionTextBox"
                                         Grid.Row="1" Grid.Column="1"
                                         IsReadOnly="True"
                                         Margin="0,2"/>

                                <!-- 横サイズ -->
                                <TextBlock Text="横サイズ:" 
                                           Grid.Row="2" Grid.Column="0"
                                           Margin="0,2,5,2"
                                           VerticalAlignment="Center"/>
                                <TextBox x:Name="ImageWidthTextBox"
                                         Grid.Row="2" Grid.Column="1"
                                         IsReadOnly="True"
                                         Margin="0,2"/>

                                <!-- 縦サイズ -->
                                <TextBlock Text="縦サイズ:" 
                                           Grid.Row="3" Grid.Column="0"
                                           Margin="0,2,5,2"
                                           VerticalAlignment="Center"/>
                                <TextBox x:Name="ImageHeightTextBox"
                                         Grid.Row="3" Grid.Column="1"
                                         IsReadOnly="True"
                                         Margin="0,2"/>

                                <!-- ファイルサイズ -->
                                <TextBlock Text="ファイルサイズ:" 
                                           Grid.Row="4" Grid.Column="0"
                                           Margin="0,2,5,2"
                                           VerticalAlignment="Center"/>
                                <TextBox x:Name="ImageFileSizeTextBox"
                                         Grid.Row="4" Grid.Column="1"
                                         IsReadOnly="True"
                                         Margin="0,2"/>
                            </Grid>
                        </Grid>

                        <!-- 右側：テキストファイル内容 (変更なし) -->
                        <Grid Grid.Column="1">
                            <!-- テキストファイル内容のヘッダーを追加する場合 -->
                            <!-- <TextBlock Text="テキストファイル内容" FontWeight="Bold" Margin="5,5,0,5"/> -->
                            <TextBox x:Name="AssociatedText" 
                                     IsReadOnly="True" 
                                     TextWrapping="Wrap" 
                                     Margin="5,0,0,0" 
                                     VerticalScrollBarVisibility="Auto" 
                                     AcceptsReturn="True"/> 
                        </Grid>
                    </Grid> <!-- ExpanderコンテンツのGrid終了 -->
                </Expander> <!-- Expander終了 -->
            </Grid>
            
            <!-- オプション欄 -->
            <Grid Grid.Row="3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1*"/>
                    <ColumnDefinition Width="1*"/>
                </Grid.ColumnDefinitions>
                
                <!-- 左側のオプション -->
                <StackPanel Grid.Column="0" Margin="5,0,0,0">
                    <StackPanel Orientation="Horizontal" Margin="0,5">
                        <TextBlock Text="VLMモデル:" VerticalAlignment="Center" Margin="0,0,5,0"/>
                        <ComboBox x:Name="VLMModelComboBox" Width="200" SelectionChanged="VLMModelComboBox_SelectionChanged"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,5">
                        <TextBlock Text="General:" VerticalAlignment="Center" Margin="0,0,5,0"/>
                        <Slider x:Name="GeneralThresholdSlider" Width="150" Minimum="0" Maximum="1" Value="0.35" 
                                TickFrequency="0.05" IsSnapToTickEnabled="True" ValueChanged="GeneralThresholdSlider_ValueChanged"/>
                        <TextBlock x:Name="GeneralThresholdValue" Text="{Binding ElementName=GeneralThresholdSlider, Path=Value, StringFormat={}{0:F2}}" 
                                   VerticalAlignment="Center" Margin="5,0,0,0"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,5">
                        <TextBlock Text="Character:" VerticalAlignment="Center" Margin="0,0,5,0"/>
                        <Slider x:Name="CharacterThresholdSlider" Width="150" Minimum="0" Maximum="1" Value="0.85" 
                                TickFrequency="0.05" IsSnapToTickEnabled="True" ValueChanged="CharacterThresholdSlider_ValueChanged"/>
                        <TextBlock x:Name="CharacterThresholdValue" Text="{Binding ElementName=CharacterThresholdSlider, Path=Value, StringFormat={}{0:F2}}" 
                                   VerticalAlignment="Center" Margin="5,0,0,0"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,5">
                        <CheckBox x:Name="UseGPUCheckBox" Content="GPUを使用して推論する" IsChecked="True" Checked="UseGPUCheckBox_Checked" Unchecked="UseGPUCheckBox_Checked"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,5">
                        <TextBlock Text="VLM Concurrency:" VerticalAlignment="Center" Margin="0,0,5,0"/>
                        <Slider x:Name="VLMConcurrencySlider" Width="100" Minimum="1" Maximum="64" Value="14" 
                                TickFrequency="1" IsSnapToTickEnabled="True"/>
                        <TextBlock x:Name="VLMConcurrencyValue" Text="{Binding ElementName=VLMConcurrencySlider, Path=Value, StringFormat={}{0:F0}}" 
                                   VerticalAlignment="Center" Margin="5,0,0,0"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,5">
                        <CheckBox x:Name="UseCustomCategoriesCheckBox" Content="ユーザーカスタムカテゴリを使用" IsChecked="True" Checked="UseCustomCategoriesCheckBox_Checked" Unchecked="UseCustomCategoriesCheckBox_Checked" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,5">
                        <CheckBox x:Name="ShuffleInCategoriesCheckBox" Content="カテゴリ内でシャッフル" IsChecked="False"/>
                    </StackPanel>
                </StackPanel>
                
                <!-- 右側のタグカテゴリリストビュー -->
                <Grid Grid.Row="2" Grid.Column="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <ListView x:Name="TagCategoryListView" Grid.Column="0" Margin="5,0,0,0">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding OrderType}" Value="Prefix">
                                        <Setter Property="Background" Value="LightBlue"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding OrderType}" Value="Suffix">
                                        <Setter Property="Background" Value="LightPink"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="カテゴリ" DisplayMemberBinding="{Binding Name}" Width="120"/>
                                <GridViewColumn Header="順序" Width="auto">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding OrderType}">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding OrderType}" Value="Prefix">
                                                                <Setter Property="Text" Value="Prefix"/>
                                                                <Setter Property="Foreground" Value="Blue"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding OrderType}" Value="Suffix">
                                                                <Setter Property="Text" Value="Suffix"/>
                                                                <Setter Property="Foreground" Value="Red"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                            </GridView>
                        </ListView.View>
                    </ListView>
                    <StackPanel Grid.Column="1" Orientation="Vertical">
                        <Button Content="先頭に追加" Click="MoveToPrefix_Click" Margin="5"/>
                        <Button Content="末尾に追加" Click="MoveToSuffix_Click" Margin="5"/>
                        <Button Content="順序から削除" Click="RemoveFromOrders_Click" Margin="5"/>
                        <Button Content="デフォルト順序" Click="SetDefaultOrder_Click" Margin="5" 
                                Background="LightYellow" ToolTip="Rating,Quality,Character,Copyright,Artist,PersonCounts(先頭) | Model,Meta(末尾)"/>
                    </StackPanel>
                </Grid>
            </Grid>

            <!-- 高度な削除と画像編集のStackPanel -->
            <StackPanel Grid.Row="4">
                <!-- 高度な削除 -->
                <Expander Header="高度な削除" Margin="5">
                    <StackPanel>
                        <!-- 孤立したタグファイルの削除 -->
                        <GroupBox Header="孤立したタグファイル" Margin="0,5">
                            <StackPanel Margin="5">
                                <TextBlock Text="紐づいている画像が存在しないtxtファイルをすべて削除します" TextWrapping="Wrap"/>
                                <Button x:Name="DeleteOrphanedTagsButton" Content="孤立タグファイルを削除" 
                                        Margin="0,5" Padding="5" Click="DeleteOrphanedTagsButton_Click"/>
                            </StackPanel>
                        </GroupBox>

                        <!-- 低解像度画像の削除 -->
                        <GroupBox Header="低解像度画像" Margin="0,5">
                            <StackPanel Margin="5">
                                <TextBlock Text="指定された解像度以下の画像とタグファイルを削除します" TextWrapping="Wrap"/>
                                <StackPanel Orientation="Horizontal" Margin="0,5">
                                    <RadioButton x:Name="LongSideRadio" Content="長辺" IsChecked="True" Margin="0,0,10,0"/>
                                    <RadioButton x:Name="ShortSideRadio" Content="短辺" Margin="0,0,10,0"/>
                                    <TextBlock Text="が" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                    <TextBox x:Name="ResolutionTextBox" Text="480" Width="60" Margin="0,0,5,0"/>
                                    <TextBlock Text="ピクセル以下" VerticalAlignment="Center"/>
                                </StackPanel>
                                <Button x:Name="DeleteLowResButton" Content="低解像度画像を削除" Margin="0,5" Padding="5" Click="DeleteLowResButton_Click"/>
                            </StackPanel>
                        </GroupBox>

                        <!-- タグ数が少ない画像の削除 -->
                        <GroupBox Header="タグ数が少ない画像" Margin="0,5">
                            <StackPanel Margin="5">
                                <TextBlock Text="指定された数以下のタグを持つ画像とタグファイルを削除します（タグがない画像は除外）" TextWrapping="Wrap"/>
                                <StackPanel Orientation="Horizontal" Margin="0,5">
                                    <TextBox x:Name="TagCountTextBox" Text="3" Width="60" Margin="0,0,5,0"/>
                                    <TextBlock Text="個以下のタグ" VerticalAlignment="Center"/>
                                </StackPanel>
                                <Button x:Name="DeleteLowTagCountButton" Content="タグ数が少ない画像を削除" Margin="0,5" Padding="5" Click="DeleteLowTagCountButton_Click"/>
                            </StackPanel>
                        </GroupBox>
                    </StackPanel>
                </Expander>

                <!-- 画像編集 -->
                <Expander Header="画像編集" Margin="5">
                    <StackPanel Orientation="Horizontal">
                        <GroupBox Header="透過部分の塗りつぶし" Margin="5">
                            <StackPanel Margin="5">
                                <TextBlock Text="透過部分を指定した色で塗りつぶします" TextWrapping="Wrap"/>
                                <StackPanel Orientation="Horizontal" Margin="0,5">
                                    <TextBlock Text="R:" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                    <TextBox x:Name="FillRedTextBox" Text="255" Width="40" Margin="0,0,10,0"/>
                                    <TextBlock Text="G:" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                    <TextBox x:Name="FillGreenTextBox" Text="255" Width="40" Margin="0,0,10,0"/>
                                    <TextBlock Text="B:" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                    <TextBox x:Name="FillBlueTextBox" Text="255" Width="40"/>
                                </StackPanel>
                                <CheckBox x:Name="RandomColorInvertCheckBox" Content="ランダム色反転" Margin="0,5"/>
                                <CheckBox x:Name="ApplyToAllImagesCheckBox" Content="全画像に適用" Margin="0,5"/>
                                <Button x:Name="FillTransparencyButton" Content="透過部分を塗りつぶす" Margin="0,5" Padding="5" Click="FillTransparencyButton_Click"/>
                            </StackPanel>
                        </GroupBox>

                        <GroupBox Header="リサイズ" Margin="5">
                            <StackPanel>
                                <Grid Margin="0,5,0,5">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="60"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="60"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="サイズ: 横" VerticalAlignment="Center" Grid.Column="0"/>
                                    <TextBox x:Name="ResizeWidthTextBox" Text="1024" Grid.Column="1" Margin="5,0"/>
                                    <TextBlock Text="縦" VerticalAlignment="Center" Grid.Column="2"/>
                                    <TextBox x:Name="ResizeHeightTextBox" Text="1024" Grid.Column="3" Margin="5,0"/>
                                    <TextBlock Text="px" VerticalAlignment="Center" Grid.Column="4"/>
                                </Grid>
                                
                                <Grid Margin="0,5">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="80"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    
                                    <TextBlock Text="モード:" VerticalAlignment="Center" Grid.Row="0" Grid.Column="0"/>
                                    <ComboBox x:Name="ResizeModeComboBox" Grid.Row="0" Grid.Column="1" Margin="0,2">
                                        <ComboBoxItem Content="縮小のみ" IsSelected="True"/>
                                        <ComboBoxItem Content="拡大/縮小"/>
                                    </ComboBox>
                                    
                                    <TextBlock Text="出力形式:" VerticalAlignment="Center" Grid.Row="1" Grid.Column="0"/>
                                    <ComboBox x:Name="OutputFormatComboBox" Grid.Row="1" Grid.Column="1" Margin="0,2">
                                        <ComboBoxItem Content="WebP" IsSelected="True"/>
                                        <ComboBoxItem Content="PNG"/>
                                        <ComboBoxItem Content="JPEG"/>
                                    </ComboBox>
                                    
                                    <TextBlock Text="リサンプル:" VerticalAlignment="Center" Grid.Row="2" Grid.Column="0"/>
                                    <ComboBox x:Name="ResampleModeComboBox" Grid.Row="2" Grid.Column="1" Margin="0,2">
                                        <ComboBoxItem Content="Lanczos2" IsSelected="True"/>
                                        <ComboBoxItem Content="Lanczos3"/>
                                        <ComboBoxItem Content="Bilinear"/>
                                        <ComboBoxItem Content="NearestNeighbor"/>
                                    </ComboBox>
                                </Grid>

                                <StackPanel Orientation="Horizontal" Margin="5,0">
                                    <TextBlock Text="ランダム倍率差分:" VerticalAlignment="Center"/>
                                    <TextBox x:Name="RandomScaleVariationTextBox" Text="0.0" Width="40" Margin="5,0"/>
                                    <TextBlock Text="刻み:" VerticalAlignment="Center" Margin="10,0,0,0"/>
                                    <TextBox x:Name="RandomScaleStepTextBox" Text="0.05" Width="40" Margin="5,0"/>
                                </StackPanel>
                                
                                <CheckBox x:Name="ResizeApplyToAllCheckBox" Content="すべての画像に適用" Margin="0,5"/>
                                <Button x:Name="ResizeButton" Content="リサイズを実行" Margin="0,5" Padding="5" Click="ResizeButton_Click"/>
                            </StackPanel>
                        </GroupBox>
                    </StackPanel>
                </Expander>
            </StackPanel>
        </Grid>


        <!-- 右ペイン1: 個別タグ -->
        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Center">
                <Button x:Name="AddTagButton" Click="AddTagButton_Click">
                    <Button.Content>
                        <Image Source="/icon/add.png" Width="32" Height="32"/>
                    </Button.Content>
                    <Button.ToolTip>
                        <TextBlock Text="タグを追加(Ctrl+T)"/>
                    </Button.ToolTip>
                </Button>
                <Button x:Name="RemoveTagButton" Click="RemoveTagButton_Click">
                    <Button.Content>
                        <Image Source="/icon/erase.png" Width="32" Height="32"/>
                    </Button.Content>
                    <Button.ToolTip>
                        <TextBlock Text="タグを削除(Ctrl+D)"/>
                    </Button.ToolTip>
                </Button>
                <Button x:Name="MoveTopButton" Click="MoveTopButton_Click">
                    <Button.Content>
                        <Image Source="/icon/up.png" Width="32" Height="32"/>
                    </Button.Content>
                    <Button.ToolTip>
                        <TextBlock Text="選択しているタグをtopに移動(Ctrl+↑)"/>
                    </Button.ToolTip>
                </Button>
                <Button x:Name="MoveBottomButton" Click="MoveBottomButton_Click">
                    <Button.Content>
                        <Image Source="/icon/down.png" Width="32" Height="32"/>
                    </Button.Content>
                    <Button.ToolTip>
                        <TextBlock Text="選択しているタグをbottomに移動(Ctrl+↓)"/>
                    </Button.ToolTip>
                </Button>
                <Button x:Name="DeselectTagButton" Click="DeselectTagButton_Click">
                    <Button.Content>
                        <Image Source="/icon/deselect.png" Width="32" Height="32"/>
                    </Button.Content>
                    <Button.ToolTip>
                        <TextBlock Text="選択されているタグを解除(Ctrl+E))"/>
                    </Button.ToolTip>
                </Button>
                <Button x:Name="SortByCategoryButton" Click="SortByCategoryButton_Click">
                    <Button.Content>
                        <Image Source="/icon/sort.png" Width="32" Height="32"/>
                    </Button.Content>
                    <Button.ToolTip>
                        <TextBlock Text="カテゴリ順に並び替え(Ctrl+R)"/>
                    </Button.ToolTip>
                </Button>
                <Button x:Name="VLMPredictButton" Click="VLMPredictButton_Click">
                    <Button.Content>
                        <Image Source="/icon/vlm.png" Width="32" Height="32"/>
                    </Button.Content>
                    <Button.ToolTip>
                        <TextBlock Text="VLMでタグを作成(Ctrl+P)"/>
                    </Button.ToolTip>
                    <Button.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="選択範囲のみ推論" Click="PredictSelectedRegion_Click"/>
                        </ContextMenu>
                    </Button.ContextMenu>
                </Button>
            </StackPanel>
            
            <!-- Caption編集エリア -->
            <Grid Grid.Row="1" Margin="5">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="Caption:" FontWeight="Bold" Margin="0,0,0,2"/>
                <TextBox x:Name="CaptionTextBox" Grid.Row="1" 
                         Text="{Binding SelectedImage.Caption, UpdateSourceTrigger=PropertyChanged}"
                         TextWrapping="Wrap" AcceptsReturn="True" MinHeight="60" MaxHeight="120"
                         ScrollViewer.VerticalScrollBarVisibility="Auto" Margin="0,0,0,5"
                         FontFamily="Consolas" FontSize="12" TextChanged="CaptionTextBox_TextChanged"/>
                <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center">
                    <Button x:Name="GenerateCaptionButton" Click="GenerateCaptionButton_Click" 
                            Width="120" Height="30" Margin="0,0,5,0">
                        <StackPanel Orientation="Horizontal">
                            <Image Source="/icon/vlm.png" Width="16" Height="16" Margin="0,0,5,0"/>
                            <TextBlock Text="Caption生成"/>
                        </StackPanel>
                        <Button.ToolTip>
                            <TextBlock Text="GLM-4.1Vでキャプションを生成(Ctrl+G)"/>
                        </Button.ToolTip>
                    </Button>
                    <Button x:Name="GenerateAllCaptionsButton" Click="GenerateAllCaptionsButton_Click" 
                            Width="120" Height="30" Margin="0,0,5,0">
                        <StackPanel Orientation="Horizontal">
                            <Image Source="/icon/vlm.png" Width="16" Height="16" Margin="0,0,5,0"/>
                            <TextBlock Text="全Caption生成"/>
                        </StackPanel>
                        <Button.ToolTip>
                            <TextBlock Text="全画像にキャプションを生成(Ctrl+Shift+G)"/>
                        </Button.ToolTip>
                    </Button>
                    <Button x:Name="StopCaptionGenerationButton" Click="StopCaptionGenerationButton_Click" 
                            Width="80" Height="30" Margin="0,0,5,0" IsEnabled="False">
                        <StackPanel Orientation="Horizontal">
                            <Image Source="/icon/cancel.png" Width="16" Height="16" Margin="0,0,5,0"/>
                            <TextBlock Text="停止"/>
                        </StackPanel>
                        <Button.ToolTip>
                            <TextBlock Text="キャプション生成を停止"/>
                        </Button.ToolTip>
                    </Button>
                    <Button x:Name="ClearCaptionButton" Click="ClearCaptionButton_Click" 
                            Width="80" Height="30">
                        <StackPanel Orientation="Horizontal">
                            <Image Source="/icon/erase.png" Width="16" Height="16" Margin="0,0,5,0"/>
                            <TextBlock Text="クリア"/>
                        </StackPanel>
                        <Button.ToolTip>
                            <TextBlock Text="キャプションをクリア"/>
                        </Button.ToolTip>
                    </Button>
                </StackPanel>
            </Grid>
            
            <ListView x:Name="TagListView" Grid.Row="2" SelectionMode="Multiple" 
                      SelectionChanged="TagListView_SelectionChanged"
                      ItemsSource="{Binding SelectedImage.Tags}" 
                      PreviewMouseLeftButtonDown="TagListView_PreviewMouseLeftButtonDown"
                      PreviewMouseMove="TagListView_PreviewMouseMove"
                      PreviewMouseLeftButtonUp="TagListView_PreviewMouseLeftButtonUp"
                      AllowDrop="True"
                      Drop="TagListView_Drop"
                      SizeChanged="ListView_SizeChanged">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Style.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="{StaticResource SelectedTagBrush}"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="タグ" DisplayMemberBinding="{Binding}"/>
                    </GridView>
                </ListView.View>
            </ListView>
        </Grid>

        <!-- 右ペイン2: 全タグ -->
        <Grid Grid.Column="3">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Center">
                <Button x:Name="AddSelectedTagsToAllButton" Click="AddAllTagsButton_Click">
                    <Button.Content>
                        <Image Source="/icon/addm.png" Width="32" Height="32"/>
                    </Button.Content>
                    <Button.ToolTip>
                        <TextBlock Text="選択しているタグを全画像に追加(Ctrl+Shift+T)"/>
                    </Button.ToolTip>
                </Button>
                <Button x:Name="RemoveAllTagsButton" Click="RemoveAllTagsButton_Click">
                    <Button.Content>
                        <Image Source="/icon/erasem.png" Width="32" Height="32"/>
                    </Button.Content>
                    <Button.ToolTip>
                        <TextBlock Text="選択しているタグを全画像から削除(Ctrl+Shift+D)"/>
                    </Button.ToolTip>
                </Button>
                <Button x:Name="MoveTopAllButton" Click="MoveTopAllButton_Click">
                    <Button.Content>
                        <Image Source="/icon/up.png" Width="32" Height="32"/>
                    </Button.Content>
                    <Button.ToolTip>
                        <TextBlock Text="選択しているタグを全画像でtopに移動(Ctrl+Shift+↑)"/>
                    </Button.ToolTip>
                </Button>
                <Button x:Name="MoveBottomAllButton" Click="MoveBottomAllButton_Click">
                    <Button.Content>
                        <Image Source="/icon/down.png" Width="32" Height="32"/>
                    </Button.Content>
                    <Button.ToolTip>
                        <TextBlock Text="選択しているタグを全画像でbottomに移動(Ctrl+Shift+↓)"/>
                    </Button.ToolTip>
                </Button>
                <Button x:Name="DeselectAllTagsButton" Click="DeselectAllTagsButton_Click">
                    <Button.Content>
                        <Image Source="/icon/deselect.png" Width="32" Height="32"/>
                    </Button.Content>
                    <Button.ToolTip>
                        <TextBlock Text="選択されているタグをすべて解除(Ctrl+Shift+E)"/>
                    </Button.ToolTip>
                </Button>
                <Button x:Name="SortByCategoryAllButton" Click="SortByCategoryAllButton_Click">
                    <Button.Content>
                        <Image Source="/icon/sort.png" Width="32" Height="32"/>
                    </Button.Content>
                    <Button.ToolTip>
                        <TextBlock Text="すべての画像をカテゴリ順に並び替え(Ctrl+Shift+R)"/>
                    </Button.ToolTip>
                </Button>
                <Button x:Name="VLMPredictAllButton" Click="VLMPredictAllButton_Click">
                    <Button.Content>
                        <Image Source="/icon/vlm.png" Width="32" Height="32"/>
                    </Button.Content>
                    <Button.ToolTip>
                        <TextBlock Text="VLMですべての画像にタグを作成(Ctrl+Shift+P)"/>
                    </Button.ToolTip>
                </Button>
            </StackPanel>
            <ListView x:Name="AllTagsListView" Grid.Row="1" SelectionMode="Multiple" SelectionChanged="AllTagsListView_SelectionChanged"
                      ItemsSource="{Binding AllTags}" 
                      PreviewMouseLeftButtonDown="AllTagsListView_PreviewMouseLeftButtonDown"
                      SizeChanged="ListView_SizeChanged">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                <Setter Property="Background" Value="{StaticResource SelectedTagBrush}"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="タグ" DisplayMemberBinding="{Binding Tag}"/>
                        <GridViewColumn Header="Count" Width="60">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Count}" Width="30"/>
                                        <TextBlock Text="★">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsCurrentImageTag}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Header="カテゴリ" DisplayMemberBinding="{Binding Category}" Width="80"/>
                    </GridView>
                </ListView.View>
            </ListView>
        </Grid>

        <!-- 新しい列：ボタン配置用 -->
        <StackPanel Grid.Column="4" Orientation="Vertical">   
            <Button x:Name="ReplaceTagButton" Click="ReplaceTagButton_Click">
                <Button.Content>
                    <Image Source="/icon/replace.png" Width="32" Height="32"/>
                </Button.Content>
                <Button.ToolTip>
                    <TextBlock Text="タグの置換(Ctrl+H)"/>
                </Button.ToolTip>
            </Button>
            <Button x:Name="AddFolderNameButton" Click="AddFolderNameButton_Click">
                <Button.Content>
                    <Image Source="/icon/addfname.png" Width="32" Height="32"/>
                </Button.Content>
                <Button.ToolTip>
                    <TextBlock Text="フォルダ名をタグに追加(Ctrl+Shift+F)"/>
                </Button.ToolTip>
            </Button>
            <Button x:Name="ShuffleTagsButton" Click="ShuffleTagsButton_Click">
                <Button.Content>
                    <Image Source="/icon/shuffle.png" Width="32" Height="32"/>
                </Button.Content>
                <Button.ToolTip>
                    <TextBlock Text="タグをシャッフル(Ctrl+Shift+S)"/>
                </Button.ToolTip>
            </Button>
            <Button x:Name="CSDClusteringButton" Click="CSDClusteringButton_Click">
                <Button.Content>
                    <Image Source="/icon/csd.png" Width="32" Height="32"/>
                </Button.Content>
                <Button.ToolTip>
                    <TextBlock Text="CSDでクラスタリングを行う(Ctrl+Shift+C)"/>
                </Button.ToolTip>
            </Button>
            <Button x:Name="CreateDaughterDatasetButton" Click="CreateDaughterDatasetButton_Click" >
                <Button.Content>
                    <Image Source="/icon/daughter.png" Width="32" Height="32"/>
                </Button.Content>
                <Button.ToolTip>
                    <TextBlock Text="娘データセット作成(Ctrl+Shift+D)"/>
                </Button.ToolTip>
            </Button>
        </StackPanel>

        <!-- 右ペイン3: ログ、動作処理リス、選択されたタグ -->
        <Grid Grid.Column="5">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>  <!-- プログレスバー用 -->
                <RowDefinition Height="Auto"/>  <!-- 対象選択用ドロップダウンリスト -->
                <RowDefinition Height="Auto"/>  <!-- 検索オプション用 -->
                <RowDefinition Height="Auto"/>  <!-- 既存のタグカテゴリをオーバーライドするチェックボックス用 -->
                <RowDefinition Height="Auto"/>  <!-- 検索バー用 -->
                <RowDefinition Height="Auto"/>  <!-- 検索されたタグ用 -->
                <RowDefinition Height="1*"/>    <!-- デバッグログ用 -->
                <RowDefinition Height="2*"/>    <!-- メイン/VLMログ用 -->
                <RowDefinition Height="2*"/>    <!-- 動作処理リスト用 -->
                <RowDefinition Height="1*"/>    <!-- 選択されたタグ用とフィルタリングされているタグリスト用 -->
                <RowDefinition Height="Auto"/>    <!-- クラスター番号を選択するためのドロップダウンリスト用 -->
                <RowDefinition Height="Auto"/>    <!-- クラスタリング可視化用 -->
            </Grid.RowDefinitions>

            <!-- プログレスバー -->
            <ProgressBar x:Name="ProgressBar" Grid.Row="0" Height="20" Margin="5" Minimum="0" Maximum="100" Value="0"/>

            <TextBlock x:Name="ProcessingSpeedTextBlock" 
                    HorizontalAlignment="Right" 
                    VerticalAlignment="Bottom" 
                    Margin="10" 
                    FontSize="10" 
                    Opacity="0.7" Grid.Row="0" Grid.Column="2"/>
            <!-- 対象選択用ドロップダウンリスト -->
            <ComboBox x:Name="SearchTargetComboBox" Grid.Row="1" Margin="5" SelectedIndex="0">
                <ComboBoxItem Content="CurrentTags (現在表示中の画像のタグ)"/>
                <ComboBoxItem Content="AllImageTags (全画像のタグ)"/>
                <ComboBoxItem Content="Dictionary (タグ辞書)"/>
            </ComboBox>

            <!-- 検索オプション -->
            <ComboBox x:Name="SearchOptionComboBox" Grid.Row="2" Margin="5" SelectedIndex="0">
                <ComboBoxItem x:Name="PartialMatchOption" Content="Partial Match"/>
                <ComboBoxItem x:Name="PrefixMatchOption" Content="Prefix Match"/>
                <ComboBoxItem x:Name="PhraseMatchOption" Content="Phrase Match"/>
            </ComboBox>

            <!-- チェックボックス群 -->
            <StackPanel Grid.Row="3" Orientation="Vertical" Margin="5">
                <CheckBox x:Name="OverrideExistingCategoriesCheckBox" Content="既存のタグカテゴリをオーバーライドする" IsChecked="False" Margin="0,2"/>
                <CheckBox x:Name="HideZeroCountTagsCheckBox" Content="カウント0のタグを非表示" IsChecked="False" Margin="0,2" 
                          Checked="HideZeroCountTagsCheckBox_Changed" Unchecked="HideZeroCountTagsCheckBox_Changed"/>
            </StackPanel>

            <!-- 検索バーとボタン -->
            <Grid Grid.Row="4" Margin="5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="SearchTextBox" Grid.Column="0" Height="20" VerticalAlignment="Center" 
                         TextChanged="SearchTextBox_TextChanged" PreviewKeyDown="SearchTextBox_PreviewKeyDown"/>
                <Button x:Name="AddTextboxinputButton" Grid.Column="1" Click="AddTextboxinputButton_Click">
                    <Button.Content>
                        <Image Source="/icon/add.png" Width="32" Height="32"/>
                    </Button.Content>
                    <Button.ToolTip>
                        <TextBlock Text="個別タグに追加(Ctrl+Enter)"/>
                    </Button.ToolTip>
                </Button>
                <Button x:Name="AddAllTextboxinputButton" Grid.Column="2" Click="AddAllTextboxinputButton_Click">
                    <Button.Content>
                        <Image Source="/icon/addm.png" Width="32" Height="32"/>
                    </Button.Content>
                    <Button.ToolTip>
                        <TextBlock Text="全タグに追加(Ctrl+Shift+Enter)"/>
                    </Button.ToolTip>
                </Button>
            </Grid>

            <!-- 検索されたタグのリストビュー -->
            <ListView x:Name="SearchedTagsListView" Grid.Row="5" Height="160" 
                      SelectionMode="Multiple" SelectionChanged="SearchedTagsListView_SelectionChanged"
                      PreviewKeyDown="SearchedTagsListView_PreviewKeyDown"
                      ItemsSource="{Binding SearchedTags}"
                      SizeChanged="ListView_SizeChanged">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Style.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="{StaticResource SelectedTagBrush}"/>
                                <Setter Property="BorderBrush" Value="{StaticResource SelectedTagBrush}"/>
                                <Setter Property="BorderThickness" Value="2"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="タグ" DisplayMemberBinding="{Binding Tag}"/>
                        <GridViewColumn Header="カウント" DisplayMemberBinding="{Binding Count}" Width="60"/>
                    </GridView>
                </ListView.View>
            </ListView>

            <!-- デバッグログの表示領域-->
            <TextBox x:Name="DebugLogTextBox" Grid.Row="6" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>

            <!-- ログ表示用のTabControl -->
            <TabControl Grid.Row="7">
                <TabItem Header="メインログ">
                    <TextBox x:Name="MainLogTextBox" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" />
                </TabItem>
                <TabItem Header="VLMログ">
                    <TextBox x:Name="VLMLogTextBox" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" />
                </TabItem>
                <TabItem Header="Pipeログ">
                    <TextBox x:Name="PipelineLogTextBox" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" />
                </TabItem>
                <TabItem Header="Pythonログ">
                    <TextBox x:Name="PythonLogTextBox" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" 
                             FontFamily="Consolas" FontSize="11" />
                </TabItem>
            </TabControl>

            <!-- Undo/Redoのための動作処理リスト -->
            <ListView x:Name="ActionListView" Grid.Row="8">
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="操作" DisplayMemberBinding="{Binding ActionType}"/>
                        <GridViewColumn Header="詳細" DisplayMemberBinding="{Binding Description}"/>
                    </GridView>
                </ListView.View>
            </ListView>

            <!-- 選択されたタグとフィルタリングされているタグを横に並べる -->
            <!-- 選択されたタグ -->
            <ListBox x:Name="SelectedTagsListBox" Grid.Row="9" SelectionMode="Multiple"/>

            <!-- クラスター番号を選択するためのドロップダウンリスト-->
            <Grid Grid.Row="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <ComboBox x:Name="ClusterGroupComboBox" Grid.Column="0" Margin="5" SelectedIndex="0" SelectionChanged="ClusterGroupComboBox_SelectionChanged">
                    <ComboBoxItem Content="ALL"/>
                </ComboBox>
                <ComboBox x:Name="ClusterAnnotationComboBox" Grid.Column="1" Margin="5" SelectedIndex="0" SelectionChanged="ClusterAnnotationComboBox_SelectionChanged">
                    <ComboBoxItem Content="Default"/>
                    <ComboBoxItem Content="Tags_And"/>
                    <ComboBoxItem Content="Tags_Or"/>
                </ComboBox>
            </Grid>
            <!-- クラスタリング可視化用の画像表示領域 -->
            <Image x:Name="ClusteringVisualizationImage" Grid.Row="11" Width="Auto" Height="Auto" Margin="0"/>

        </Grid>

        <!-- 右端：フィルタ条件パネル -->
        <Grid Grid.Column="6">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>  <!-- ヘッダー -->
                <RowDefinition Height="*"/>     <!-- 条件リスト -->
                <RowDefinition Height="Auto"/>  <!-- コントロールボタン -->
            </Grid.RowDefinitions>
            
            <!-- フィルタパネルヘッダー -->
            <StackPanel Grid.Row="0" Background="#F0F0F0" Margin="5">
                <TextBlock Text="フィルタ条件" FontWeight="Bold" HorizontalAlignment="Center" Margin="5"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Button x:Name="AddTagFilterConditionButton" Content="タグ＋" Width="40" Height="25" 
                            Click="AddTagFilterConditionButton_Click" ToolTip="選択タグを条件に追加"/>
                    <Button x:Name="AddCategoryFilterConditionButton" Content="カテゴリ＋" Width="55" Height="25" 
                            Click="AddCategoryFilterConditionButton_Click" ToolTip="カテゴリを条件に追加" Margin="3,0,0,0"/>
                    <Button x:Name="ClearFilterConditionsButton" Content="✕" Width="30" Height="25" 
                            Click="ClearFilterConditionsButton_Click" ToolTip="条件をクリア" Margin="3,0,0,0"/>
                </StackPanel>
                <!-- カテゴリ選択用ComboBox -->
                <ComboBox x:Name="CategoryFilterComboBox" Margin="5,3,5,0" Height="25" SelectedIndex="0">
                    <ComboBoxItem Content="General"/>
                    <ComboBoxItem Content="Character"/>
                    <ComboBoxItem Content="Copyright"/>
                    <ComboBoxItem Content="Artist"/>
                    <ComboBoxItem Content="Rating"/>
                    <ComboBoxItem Content="Quality"/>
                    <ComboBoxItem Content="Model"/>
                    <ComboBoxItem Content="Meta"/>
                </ComboBox>
            </StackPanel>
            
            <!-- フィルタ条件リスト -->
            <ListView x:Name="FilterConditionsListView" Grid.Row="1" Margin="5"
                      ItemsSource="{Binding FilterConditions}" 
                      ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Border BorderBrush="Gray" BorderThickness="1" Margin="2" Padding="5" Background="White">
                            <StackPanel>
                                <!-- タグ名/カテゴリ名とタイプ表示 -->
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Tag}" FontWeight="Bold" TextWrapping="Wrap"/>
                                    <TextBlock Text="{Binding TargetType, StringFormat='[{0}]'}" FontSize="10" 
                                               Foreground="Gray" Margin="5,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                                
                                <!-- 条件選択 -->
                                <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                    <ComboBox x:Name="ConditionTypeComboBox" Width="80"
                                              SelectionChanged="ConditionTypeComboBox_SelectionChanged"
                                              Loaded="ConditionTypeComboBox_Loaded"
                                              Tag="{Binding}">
                                        <ComboBoxItem Content="含む"/>
                                        <ComboBoxItem Content="含まない"/>
                                        <ComboBoxItem Content="カテゴリあり"/>
                                        <ComboBoxItem Content="カテゴリなし"/>
                                    </ComboBox>
                                    <ComboBox Width="60" SelectedIndex="0" Margin="5,0,0,0"
                                              SelectionChanged="LogicTypeComboBox_SelectionChanged"
                                              Tag="{Binding}">
                                        <ComboBoxItem Content="AND"/>
                                        <ComboBoxItem Content="OR"/>
                                    </ComboBox>
                                </StackPanel>
                                
                                <!-- 削除ボタン -->
                                <Button Content="削除" Width="50" Height="20" Margin="0,3,0,0"
                                        Click="RemoveFilterConditionButton_Click"
                                        CommandParameter="{Binding}"/>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
            
            <!-- 実行ボタン -->
            <StackPanel Grid.Row="2" Orientation="Vertical" Margin="5">
                <Button x:Name="ApplyAdvancedFilterButton" Content="フィルタ実行" Height="30" 
                        Click="ApplyAdvancedFilterButton_Click" Background="#4CAF50" Foreground="White"/>
                <Button x:Name="ResetAdvancedFilterButton" Content="フィルタ解除" Height="25" Margin="0,3,0,0"
                        Click="ResetAdvancedFilterButton_Click"/>
                <TextBlock x:Name="FilterResultTextBlock" Text="" FontSize="10" Margin="0,5,0,0" 
                           HorizontalAlignment="Center" Foreground="Gray"/>
            </StackPanel>
        </Grid>
        
    </Grid>
</Window>
